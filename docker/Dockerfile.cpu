# TorchBridge CPU Container
# Lightweight container for running TorchBridge CLI tools on CPU.
#
# Build:
#   docker build -f docker/Dockerfile.cpu -t torchbridge:cpu .
#
# Run:
#   docker run torchbridge:cpu tb-validate --model ./model.pt
#   docker run -it torchbridge:cpu /bin/bash
#
# Version: see pyproject.toml

FROM python:3.11-slim AS base

ARG TORCHBRIDGE_VERSION="0.0.0"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Copy application code
COPY src/ ./src/
COPY pyproject.toml ./

# Install TorchBridge
RUN pip install --no-cache-dir .

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD tb-doctor || exit 1

CMD ["tb-doctor"]

# Labels
LABEL org.opencontainers.image.title="TorchBridge CPU" \
      org.opencontainers.image.description="Lightweight TorchBridge CLI and validation tools for CPU" \
      org.opencontainers.image.version="${TORCHBRIDGE_VERSION}" \
      org.opencontainers.image.vendor="TorchBridge"
