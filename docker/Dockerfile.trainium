# TorchBridge AWS Trainium Container
# Provides a NeuronX environment for running TorchBridge CLI tools on AWS Trainium.
#
# Build:
#   docker build -f docker/Dockerfile.trainium -t torchbridge:trainium .
#
# Run (on Trainium instance):
#   docker run --device=/dev/neuron0 torchbridge:trainium tb-validate --model ./model.pt
#   docker run --device=/dev/neuron0 -it torchbridge:trainium /bin/bash
#
# Version: see pyproject.toml

# Use AWS Neuron SDK base image with PyTorch
FROM public.ecr.aws/neuron/pytorch-training-neuronx:2.5.1-neuronx-py311-sdk2.21.0-ubuntu22.04 AS base

ARG TORCHBRIDGE_VERSION="0.0.0"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PJRT_DEVICE=NEURON \
    NEURON_CC_FLAGS="--auto-cast=matmul --auto-cast-type=bf16"

# Create app directory
WORKDIR /app

# Install Python dependencies
RUN pip install --upgrade pip

# Copy application code
COPY src/ ./src/
COPY pyproject.toml ./

# Install TorchBridge
RUN pip install --no-cache-dir .

# Verify Neuron + PyTorch
RUN python3 -c "import torch; import torch_neuronx; print(f'PyTorch {torch.__version__}, Neuron SDK: OK')"

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD tb-doctor || exit 1

CMD ["tb-doctor"]

# Labels
LABEL org.opencontainers.image.title="TorchBridge Trainium" \
      org.opencontainers.image.description="TorchBridge CLI and validation tools with AWS Trainium NeuronX support" \
      org.opencontainers.image.version="${TORCHBRIDGE_VERSION}" \
      org.opencontainers.image.vendor="TorchBridge" \
      org.opencontainers.image.source="https://github.com/CloudlyIO/torchbridge"
