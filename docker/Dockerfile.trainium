# TorchBridge AWS Trainium Container
# Optimized for training and inference on AWS Trainium (Trn1/Trn2/Trn3) instances
#
# Build:
#   docker build -f docker/Dockerfile.trainium -t torchbridge:trainium .
#
# Run (on Trainium instance):
#   docker run --device=/dev/neuron0 -p 8000:8000 torchbridge:trainium
#
# Version: see pyproject.toml

# Use AWS Neuron SDK base image with PyTorch
FROM public.ecr.aws/neuron/pytorch-training-neuronx:2.5.1-neuronx-py311-sdk2.21.0-ubuntu22.04 AS base

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PJRT_DEVICE=NEURON \
    NEURON_CC_FLAGS="--auto-cast=matmul --auto-cast-type=bf16"

# Create app directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Install optional serving dependencies
RUN pip install "fastapi>=0.100.0,<1.0" "uvicorn>=0.23.0,<1.0" "prometheus-client>=0.17.0,<1.0" "psutil>=5.9.0,<7.0"

# Copy application code
COPY src/ ./src/
COPY pyproject.toml ./

# Install TorchBridge
RUN pip install --no-cache-dir .

# Verify Neuron + PyTorch
RUN python3 -c "import torch; import torch_neuronx; print(f'PyTorch {torch.__version__}, Neuron SDK: OK')"

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose ports
# 8000: FastAPI inference server
# 9090: Prometheus metrics
EXPOSE 8000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

# Default command: Run FastAPI server
CMD ["python", "-m", "uvicorn", "torchbridge.deployment.serving.fastapi_server:app", "--host", "0.0.0.0", "--port", "8000"]

# Labels
LABEL org.opencontainers.image.title="TorchBridge Trainium" \
      org.opencontainers.image.description="Training and inference container with AWS Trainium support" \
      org.opencontainers.image.version="0.5.23" \
      org.opencontainers.image.vendor="TorchBridge" \
      org.opencontainers.image.source="https://github.com/CloudlyIO/torchbridge"
