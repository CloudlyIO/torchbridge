# Development Docker image for TorchBridge
# Includes all development tools and optional dependencies

FROM nvidia/cuda:12.1-devel-ubuntu22.04

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-distutils \
    python3-pip \
    git \
    curl \
    wget \
    build-essential \
    cmake \
    ninja-build \
    vim \
    htop \
    tree \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.10 /usr/bin/python

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA support
RUN pip install --no-cache-dir \
    torch \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu121

# Install Triton for GPU kernel development
RUN pip install --no-cache-dir triton==2.1.0

# Set working directory
WORKDIR /workspace

# Copy source code
COPY . .

# Install TorchBridge in development mode with all dependencies
RUN pip install -e .[all,dev,cloud,serving,monitoring,benchmark]

# Install additional development tools
RUN pip install --no-cache-dir \
    jupyter \
    jupyterlab \
    ipython \
    notebook \
    tensorboard \
    wandb \
    matplotlib \
    seaborn \
    plotly \
    streamlit \
    gradio

# Create non-root user for development
RUN groupadd -g 1000 devuser \
    && useradd -m -u 1000 -g devuser -s /bin/bash devuser \
    && chown -R devuser:devuser /workspace

# Create jupyter config (token auto-generated on startup for security)
USER devuser
RUN jupyter notebook --generate-config \
    && echo "c.NotebookApp.ip = '0.0.0.0'" >> /home/devuser/.jupyter/jupyter_notebook_config.py \
    && echo "c.NotebookApp.open_browser = False" >> /home/devuser/.jupyter/jupyter_notebook_config.py

# Expose ports for development services
EXPOSE 8888 6006 8080 7860

# Set default command to bash for development
CMD ["/bin/bash"]

# Add helpful development aliases
RUN echo 'alias ll="ls -la"' >> /home/devuser/.bashrc \
    && echo 'alias tb="torchbridge"' >> /home/devuser/.bashrc \
    && echo 'alias pytest="python -m pytest"' >> /home/devuser/.bashrc \
    && echo 'export PYTHONPATH=/workspace/src:$PYTHONPATH' >> /home/devuser/.bashrc

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import torchbridge; print('ok')" || exit 1

# Metadata
LABEL maintainer="TorchBridge Team" \
      version="0.5.23-dev" \
      description="Development environment for TorchBridge hardware abstraction layer for PyTorch" \
      org.opencontainers.image.source="https://github.com/CloudlyIO/torchbridge"