# TorchBridge AMD GPU Container
# Provides a ROCm environment for running TorchBridge CLI tools.
#
# Build:
#   docker build -f docker/Dockerfile.amd -t torchbridge:amd .
#
# Run:
#   docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#     torchbridge:amd tb-validate --model ./model.pt
#   docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#     -it torchbridge:amd /bin/bash
#
# Tested on: AMD Instinct MI250X, MI300X
# Version: see pyproject.toml

# ROCm 6.2 base image with PyTorch support
FROM rocm/pytorch:rocm6.2_ubuntu22.04_py3.10_pytorch_2.4.0 AS base

ARG TORCHBRIDGE_VERSION="0.0.0"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HSA_OVERRIDE_GFX_VERSION=11.0.0

# Install additional system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Install Python dependencies
RUN pip install --upgrade pip

# Copy application code
COPY src/ ./src/
COPY pyproject.toml ./

# Install TorchBridge
RUN pip install --no-cache-dir .

# Verify ROCm + PyTorch integration
RUN python -c "import torch; print(f'PyTorch {torch.__version__}'); print(f'ROCm available: {torch.cuda.is_available()}'); print(f'HIP version: {torch.version.hip}')" || true

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD tb-doctor || exit 1

CMD ["tb-doctor"]

# Labels
LABEL org.opencontainers.image.title="TorchBridge AMD" \
      org.opencontainers.image.description="TorchBridge CLI and validation tools with AMD ROCm GPU support" \
      org.opencontainers.image.version="${TORCHBRIDGE_VERSION}" \
      org.opencontainers.image.vendor="TorchBridge" \
      org.opencontainers.image.source="https://github.com/CloudlyIO/torchbridge"
